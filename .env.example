# Frontend environment (frontend/.env) — optional.
# Leave unset to use same-origin requests (the Vite dev server proxies /api
# to http://localhost:8000). Set only when the backend runs on another host.
VITE_API_BASE_URL=http://localhost:8000

# Backend environment (backend process env) — optional.
# Comma-separated list of EXTRA allowed CORS origins for production (the
# deployed frontend origin). Local Vite dev origins are always allowed.
# Example: BACKEND_CORS_ORIGINS=https://desk.example.com
BACKEND_CORS_ORIGINS=

# No API keys or secrets are required: the agent is fully deterministic
# (model=None) and calls no external services.
