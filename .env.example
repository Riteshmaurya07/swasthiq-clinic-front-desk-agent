# Frontend environment (frontend/.env) — optional.
# Leave unset to use same-origin requests (the Vite dev server proxies /api
# to http://localhost:8000). Set only when the backend runs on another host.
VITE_API_BASE_URL=http://localhost:8000

# Backend environment (backend process env) — optional.
# Comma-separated list of EXTRA allowed CORS origins for production (the
# deployed frontend origin). Local Vite dev origins are always allowed.
# Example: BACKEND_CORS_ORIGINS=https://desk.example.com
BACKEND_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Dashboard authentication (REQUIRED for any deployment)
# ---------------------------------------------------------------------------
# The dashboard read/write APIs (/api/conversations*, /api/handoffs*) expose
# patient identities, transcripts and clinical handoffs, so they require a
# session. POST /agent/run and GET /health stay public.
#
# The server REFUSES dashboard access when these are unset — it fails closed,
# it never falls back to allowing anonymous reads.
#
# Leave every value below EMPTY. Put the real values in the deployment
# platform's secret store, never in this file and never in the repo.
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD=

# HMAC key used to sign the HttpOnly session cookie. Must be a long random
# string; rotating it invalidates every issued session.
DASHBOARD_SESSION_SECRET=

# Optional tuning (defaults shown).
#   DASHBOARD_ENV=production   -> adds the Secure cookie attribute.
#     Anything else (or unset) leaves Secure off so plain-http localhost works.
#     Recognised PaaS variables (RENDER, VERCEL, ...) turn Secure on regardless.
# DASHBOARD_ENV=development
# Session lifetime in seconds (default 28800 = 8 hours).
# DASHBOARD_SESSION_TTL_SECONDS=28800
# Force the Secure attribute on or off (overrides DASHBOARD_ENV).
# DASHBOARD_COOKIE_SECURE=false

# No API keys or model secrets are required: the agent is fully deterministic
# (model=None) and calls no external services.
